# Copy to .env for local development. Never commit the real API key.
#
# In production these come from the hosting provider's secret manager, NOT a file.

# YouTube Data API v3 key. Server-side only — it is never sent to the browser.
# Leave empty to run without search; the UI shows a generic "not available" message.
YOUTUBE_API_KEY=

# Optional private Google Sheet used as the shared song catalog. Share the Sheet
# with the service account email, then set either GOOGLE_SERVICE_ACCOUNT_JSON or
# the separate email/private-key variables below. Keep every real value in the
# hosting provider's secret manager. The server starts with an empty catalog when
# these values are absent.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Catalog!A:I
GOOGLE_SERVICE_ACCOUNT_JSON=
# Render Secret Files alternative: set this to the mounted JSON path, for example
# /etc/secrets/kavaoke-catalog.json. The file must contain the downloaded key JSON.
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=
# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use a quoted value containing literal \n between PEM lines when required by the host.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional; defaults to five minutes and has a minimum of one second.
GOOGLE_SHEETS_CACHE_TTL_MS=300000

# Port the hosted server listens on. Most providers inject this automatically.
PORT=8080

# Exact production origins allowed to call the API, comma separated.
# No wildcards. Requests from any other Origin are rejected.
# Example: https://karaoke.example.com
ALLOWED_ORIGINS=

# Only set if the provider terminates TLS in front of the app AND you need the real
# client IP for rate limiting. Value is the number of proxy hops to trust.
# Leaving it unset means proxy headers are ignored, which is the safe default.
TRUSTED_PROXY=

# Optional hosted Socket.IO admission controls. Defaults are deliberately
# conservative; normally leave these unset.
SOCKET_MAX_CONNECTIONS=120
SOCKET_GLOBAL_HANDSHAKES_PER_MINUTE=300
SOCKET_IP_HANDSHAKES_PER_MINUTE=60

# ---- Legacy local installer lane (npm run start:local) ----
PARTY_PORT=4174
DATA_DIR=
PUBLIC_BASE_URL=

{
  "name": "karaoke-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first karaoke PWA using the official YouTube embedded player.",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:windows7-server": "node scripts/build-legacy-server.mjs",
    "start": "node server/hosted/index.js",
    "start:local": "node server/index.js",
    "dev:hosted": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/hosted/index.js\" \"vite --host 127.0.0.1\"",
    "test": "vitest run tests/server tests/ui tests/hosted",
    "test:hosted": "vitest run tests/hosted",
    "test:server": "vitest run tests/server",
    "test:e2e": "npm run build && playwright test --config playwright.hosted.config.js",
    "build:local": "vite build --mode locallane",
    "test:e2e:local": "npm run build:local && node tests/e2e/clean-temp.js && playwright test",
    "test:watch": "vitest",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "start:kiosk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-kiosk.ps1",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.539.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.1",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "jake": {
      "filelist": "2.0.2"
    }
  }
}
